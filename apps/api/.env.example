# Provedor de IA usado pela camada de explicação (D4). Padrão: openai.
# Use "fake" para textos de exemplo gerados por template, sem chave de API.
AI_PROVIDER=openai

# Modelo do provedor. Padrão: gpt-5.1
AI_MODEL=gpt-5.1

# Chave da API da OpenAI. Obrigatória quando AI_PROVIDER=openai. Nunca faça commit do valor real.
OPENAI_API_KEY=
