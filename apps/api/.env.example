# Provedor de IA usado pela camada de explicação (D4). Padrão: openai.
# Use "fake" para textos de exemplo gerados por template, sem chave de API.
AI_PROVIDER=openai

# Modelo do provedor. Padrão: gpt-5.1
AI_MODEL=gpt-5.1

# Chave da API da OpenAI. Obrigatória quando AI_PROVIDER=openai. Nunca faça commit do valor real.
# Com um servidor local (LM Studio, vLLM, Ollama), use qualquer valor não vazio.
OPENAI_API_KEY=

# URL de um servidor compatível com a API da OpenAI, para usar um modelo local.
# Exemplo com o LM Studio: http://localhost:1234/v1 (e AI_MODEL com o identificador
# do modelo carregado). Vazio: a API da OpenAI.
OPENAI_BASE_URL=

# Tempo máximo de cada chamada ao provedor, em segundos. Padrão: 60.
# Modelos locais costumam precisar de mais (ex.: 180).
AI_TIMEOUT_SECONDS=60
